# Jolly VN Chapter 2 - Shrine Morning (apple-candy branch)
# Generated/packed on the host onto a real FAT floppy image.
[chapter name="Chapter 2 - Shrine Morning"]
[bg file="images/bg/shrine.png" time="0.5"]
[ch left="images/ch/jolly.png" time="0.5" fade="normal"]
[text text="Next morning. Hillside shrine in soft snow-light, quiet after the festival."]
[text name="Jolly" text="I saved half the apple candy for this morning. Still shiny! Still a tiny lantern!"]
[text name="Jolly" text="Should I make a wish at the shrine, or follow the tiny pawprints in the snow?"]
[choose name="shrine" text1="Clap twice and make a wish" value1="wish" text2="Follow the pawprints" value2="prints"]
[if lhs="${shrine}" op="==" rhs="wish"]
[goto name="wish"]
[endif]
[goto name="prints"]
[label name="wish"]
[bg file="images/bg/rooftop.png" time="0.5"]
[text name="Jolly" text="I wished for another festival, and for apple candy that never melts. Is that two wishes?"]
[text text="The shrine bell rings once. Below the hill, rooftops glow pink in the morning sun."]
[goto name="fin"]
[label name="prints"]
[text name="Jolly" text="These pawprints are exactly my size. Did I walk in a circle in my sleep?"]
[text text="The pawprints loop around the stone lantern and return to Jolly's feet."]
[label name="fin"]
[text name="Jolly" text="Chapter 2 complete - apple-candy branch. The End. Restart and try the other Chapter 1 treat!"]
[ch left="none" time="0.5"]
