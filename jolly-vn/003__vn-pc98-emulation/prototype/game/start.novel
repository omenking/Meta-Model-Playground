# Jolly VN Chapter 1 - Matsuri Lights (real Suika3 NovelML)
# Runs under suika-98.exe on PC-98. Engine draws message box, name
# plate and choice buttons; backgrounds/sprites contain NO UI.
[config name="game.locale" value="en"]
[label name="start"]
[chapter name="Chapter 1 - Matsuri Lights"]
[bg file="images/bg/matsuri.png" time="0"]
[ch left="images/ch/jolly.png" time="0" fade="normal"]
[text text="Summer festival street, night. Paper lanterns, fireworks, glowing stalls."]
[text name="Jolly" text="Waa! So many festival lights... My orb has competition tonight!"]
[text name="Jolly" text="Two stalls at the end of the street. I can only pick one treat before the fireworks finale."]
[text name="Jolly" text="Which one should I get? Chapter 2 starts from this choice."]
[choose name="treat" text1="Buy the apple candy" value1="ringo" text2="Buy the cotton candy" value2="wataame"]
[if lhs="${treat}" op="==" rhs="ringo"]
[goto name="ringo"]
[endif]
[goto name="wataame"]
[label name="ringo"]
[text name="Jolly" text="Apple candy! Crunchy and shiny, like a tiny festival lantern I can eat."]
[text text="Jolly holds the apple candy up beside the orb. Both glow under the fireworks."]
[goto name="endcard"]
[label name="wataame"]
[text name="Jolly" text="Cotton candy! A sweet little cloud on a stick. It looks like my fur!"]
[text text="Jolly holds the cotton candy up beside the orb. Both glow under the fireworks."]
[label name="endcard"]
[text name="Jolly" text="The fireworks are starting... Tomorrow will be a new day. End of Chapter 1."]
[text text="CHAPTER 2 IS ON THE FLOPPY. Insert the Chapter 2 FD in FDD2 (drive B:), then click. Or reboot with the Chapter 2 disk."]
[if lhs="${treat}" op="==" rhs="ringo"]
[load file="B:/CH02-RIN.NOV"]
[endif]
[load file="B:/CH02-WAT.NOV"]
