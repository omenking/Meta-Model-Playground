export default async function workflow(host) {
  const schema = { type: "object", required: ["complete", "evidence", "unresolved"], properties: { complete: { type: "boolean" }, evidence: { type: "array", items: { type: "string" } }, unresolved: { type: "array", items: { type: "string" } } } };
  const reports = await host.parallel([
    { input: "Research the Suika3 pc98 build route for a real PC-98 VN. Fetch and inspect https://raw.githubusercontent.com/awemorris/suika3/main/README.md and any linked build/tutorial docs you can fetch. Answer: exact artifact name, preset/toolchain, script format (NovelML tags for bg/character/text/choice), how game files are laid out on DOS (loose files vs assets.arc), image format/size limits if stated, and the smallest Phase 0 spike steps. Open every body you cite; if a fetch fails say so. Return complete/evidence/unresolved with short evidence strings including URLs.", schema, label: "suika3-pc98" },
    { input: "Research self-hosting the real WebNP2 emulator (Neko Project II kai WASM, uraraworks/webnp2). Fetch and inspect https://raw.githubusercontent.com/uraraworks/webnp2/master/README.md and the live player page https://uraraworks.github.io/WebNP2/?lang=en if fetchable. Answer: exact self-host file list or release/download location for the built player, URL parameters (hdd/fd1/fd2/run), hot floppy-swap support while running, BIOS/font ROM requirements and ROM-less FreeDOS(98) boot story, CORS needs, and license/redistribution constraints. Open every body you cite; if a fetch fails say so. Return complete/evidence/unresolved with short evidence strings including URLs.", schema, label: "webnp2-hosting" },
    { input: "Inspect the local workspace prototype at jolly-vn/003__vn-game-design/prototype (index.html, chapters, tools, README) plus source scenes in jolly-vn/001__stylized-pc98-jolly-visual-novel-concept/outputs/scenes/v2 and character sheets in jolly-vn/000__find-jolley-assets/outputs. The user flagged a double-overlay bug: generated scene images already contain baked dialogue box, name plate, choice list and Jolly portrait, and the player overlays its own UI again. Answer: (1) confirm from the actual files that UI is baked into the scene webps, (2) propose a concrete asset-separation pipeline producing CLEAN backgrounds (no UI, no baked portrait/text) and a SEPARATE Jolly character sprite with transparency, using only local files and Pillow if needed — specify crop regions or generation changes, exact output paths/formats/sizes for a 640x400 16-color PC-98 target, (3) how real DOS disk images (.hdi/.fdi, FAT12) can be created on this Linux host (name tools: mtools, python fat builders) and whether they are installed. Open every file you cite. Return complete/evidence/unresolved.", schema, label: "asset-separation" }
  ]);
  const compact = reports.map((r, i) => ({ scope: ["suika3", "webnp2", "assets"][i], ref: r?.ref ?? null, error_kind: r?.error_kind ?? null, data: r?.data ?? null }));
  const synthesis = await host.agent({ input: "Synthesize these three research reports into one build plan for replacing a fake JS VN renderer with REAL PC-98 emulation per jolly-vn/003__vn-game-design/PROTOTYPE.md. Reports: " + JSON.stringify(compact).slice(0, 9000) + " Preserve every unresolved item verbatim-ish. Order the plan: Phase 0 spike (stock suika-98.exe boots), asset separation (clean bg + separate sprite, no double overlay), real .hdi/.fdi packing, WebNP2 self-host shell with UI chrome OUTSIDE the emulated screen, chapter generation to real floppy images. Flag hard blockers (toolchain downloads, BIOS ROMs, build time) honestly. Return complete/evidence/unresolved where evidence lists the decisive facts with URLs/paths.", schema, label: "synthesis" });
  return { status: "ok", reports: compact, ref: synthesis?.ref ?? null, text: synthesis?.text ?? null, data: synthesis?.data ?? null };
}